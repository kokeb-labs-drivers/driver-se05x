# The cost table of docs/hrot-cookbook.md and `hrot::cost` in inc/se05x_hrot.hpp name the same constants
# with the same APDU counts, so the documented budget cannot drift from what the facade admits.
#   cmake -DDOC=<docs/hrot-cookbook.md> -DHEADER=<inc/se05x_hrot.hpp> -P check_costs.cmake
file(READ "${HEADER}" header)
string(FIND "${header}" "namespace cost {" begin)
string(FIND "${header}" "} // namespace cost" end)
if(begin EQUAL -1 OR end EQUAL -1)
  message(FATAL_ERROR "no namespace cost in ${HEADER}")
endif()
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${header}" ${begin} ${length} block)
string(REGEX MATCHALL "constexpr uint32_t k[A-Za-z0-9]+ = [0-9]+U" defs "${block}")
file(READ "${DOC}" doc)
string(REGEX MATCHALL "\\| `k[A-Za-z0-9]+` \\| [0-9]+ \\|" rows "${doc}")
list(LENGTH defs n_defs)
list(LENGTH rows n_rows)
if(NOT n_defs EQUAL n_rows OR n_defs EQUAL 0)
  message(FATAL_ERROR "hrot::cost has ${n_defs} constants, the docs table ${n_rows} rows")
endif()
foreach(def ${defs})
  string(REGEX MATCH "(k[A-Za-z0-9]+) = ([0-9]+)U" m "${def}")
  set(name "${CMAKE_MATCH_1}")
  set(value "${CMAKE_MATCH_2}")
  string(FIND "${doc}" "| `${name}` | ${value} |" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "docs/hrot-cookbook.md does not show ${name} = ${value}")
  endif()
endforeach()
message(STATUS "${n_defs} costs agree")
