 * @file se05x_version.h
 * @brief SE05X driver version, generated by CMake from se05x_version.h.in.
 * @copyright Copyright (c) 2026 The driver-se05x authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/se05x_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef SE05X_VERSION_H
#define SE05X_VERSION_H

/** Major version: incompatible API changes. */
#define SE05X_VERSION_MAJOR @SE05X_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define SE05X_VERSION_MINOR @SE05X_VERSION_MINOR@
/** Patch version: fixes. */
#define SE05X_VERSION_PATCH @SE05X_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define SE05X_VERSION_STRING "@SE05X_VERSION@"

#endif // SE05X_VERSION_H
